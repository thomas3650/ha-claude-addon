#!/usr/bin/env bash
# Main process of the add-on. Runs as root. Claude Code runs as the user
# "claude" and never sees this process's environment.
set -uo pipefail

LIB=/usr/local/lib/ha-claude
for f in paths log options env layout sync managed retention diagnostics session outcome commands; do
  # shellcheck disable=SC1090
  . "$LIB/$f.sh"
done

install_extra_packages() {
  local -a packages
  mapfile -t packages < <(jq -r '.extra_packages[]? // empty' "$HC_OPTIONS" 2>/dev/null)
  (( ${#packages[@]} )) || return 0
  log "installing extra packages: ${packages[*]}"
  if ! { timeout 120 apt-get update -qq && timeout 600 apt-get install -y --no-install-recommends "${packages[@]}"; } </dev/null; then
    log "WARNING: extra packages could not be installed; continuing"
  fi
}

start_ingress() {
  local allow="allow 172.30.32.2; deny all;"
  # HC_INGRESS_ALLOW=all is for the container smoke test only.
  [[ "${HC_INGRESS_ALLOW:-}" == "all" ]] && allow=""
  sed "s/__ALLOW__/$allow/" /etc/nginx/templates/ingress.conf.tpl > /etc/nginx/nginx.conf
  nginx
  ttyd -i lo -p 7682 -W /usr/local/bin/ha-claude-attach >/dev/null 2>&1 &
  ttyd -i lo -p 7683 -W /usr/local/bin/ha-claude-shell >/dev/null 2>&1 &
}

shutdown() {
  log "stopping"
  as_claude tmux -L "$HC_TMUX_SOCKET" kill-server 2>/dev/null || true
  nginx -s quit 2>/dev/null || true
  exit 0
}
trap shutdown TERM INT

resolve_tz
ensure_layout
install_extra_packages
run_diagnostics
sync_workspace
ensure_layout
install_managed_settings
start_ingress
start_chat
clear_stale_locks
logged_in || log "Claude Code is not logged in: open the add-on's web terminal and follow the steps shown"
prune_handover
pruned="$(date +%F)"
log "ready"

# Short waits, so a stop signal is handled within the manifest's timeout.
ticks=0
line=""
while true; do
  if read_command 5 line; then
    handle_command "$line"
  else
    rc=$?
    # 1 means standard input is closed; wait instead of spinning.
    if (( rc == 1 )); then sleep 5 & wait $!; fi
  fi
  ticks=$((ticks + 1))
  if (( ticks % 6 == 0 )); then chat_alive || start_chat; fi
  # Retention ran at start; here once on each new day.
  today="$(date +%F)"
  if [[ "$today" != "$pruned" ]]; then
    prune_handover
    pruned="$today"
  fi
done
