#!/usr/bin/env bash
# Main process of the add-on. Runs as root. Claude Code runs as the user
# "claude" and never sees this process's environment.
set -uo pipefail

LIB=/usr/local/lib/ha-claude
for f in paths log options env layout sync managed retention diagnostics web session outcome morning result run report memory jobs fixed mqtt commands; do
  # shellcheck disable=SC1090
  . "$LIB/$f.sh"
done

install_extra_packages() {
  local -a packages
  mapfile -t packages < <(jq -r '.extra_packages[]? // empty' "$HC_OPTIONS" 2>/dev/null)
  (( ${#packages[@]} )) || return 0
  log "installing extra packages: ${packages[*]}"
  if ! { timeout 120 apt-get update -qq && timeout 600 apt-get install -y --no-install-recommends "${packages[@]}"; } </dev/null; then
    log "WARNING: extra packages could not be installed; continuing"
  fi
}

start_ingress() {
  write_proxy_auth
  write_extra_auth
  # For root only: an extra server's address may hold its secret path.
  rm -f /etc/nginx/nginx.conf
  ( umask 077; render_nginx_conf /etc/nginx/templates/ingress.conf.tpl > /etc/nginx/nginx.conf )
  nginx || log "WARNING: nginx did not start; the panel and the way to Home Assistant are down"
  ttyd -i lo -p 7682 -W /usr/local/bin/ha-claude-attach >/dev/null 2>&1 &
  ttyd -i lo -p 7683 -W /usr/local/bin/ha-claude-shell >/dev/null 2>&1 &
}

shutdown() {
  log "stopping"
  # The jobs' runs, each with all it started. A runner may still write
  # that its run failed; one that does not is failed at the next start.
  jobs_stop
  mqtt_listen_stop
  as_claude tmux -L "$HC_TMUX_SOCKET" kill-server 2>/dev/null || true
  # A morning run in progress, and anything else the Claude user runs.
  pkill -TERM -u "$HC_USER" 2>/dev/null || true
  nginx -s quit 2>/dev/null || true
  exit 0
}
trap shutdown TERM INT

resolve_tz
ensure_layout
# Before any tick: a job the last stop left running is failed.
jobs_startup
# The broker, when there is one: the jobs are published again, the gone
# ones removed, and the listener for the switches starts. Without one, the
# log says so once and no job runs.
jobs_can_run || true
install_extra_packages
run_diagnostics
sync_workspace
ensure_layout
# The working folder's fixed jobs are placed in the jobs folder.
fixed_place
install_managed_settings
start_ingress
{ check_proxy; check_extra_mcp; } &
start_chat
# A run's request to clear the chat that a restart left: carried out now,
# after jobs_startup and once the chat has started.
jobs_after_run
logged_in || log "Claude Code is not logged in: open the add-on's web terminal and follow the steps shown"
prune_handover
pruned="$(date +%F)"
log "ready"

# Short waits, so a stop signal is handled within the manifest's timeout.
ticks=0
line=""
while true; do
  if read_command 5 line; then
    handle_command "$line"
  else
    rc=$?
    # 1 means standard input is closed; wait instead of spinning.
    if (( rc == 1 )); then sleep 5 & wait $!; fi
  fi
  # On every pass, so after each command too: a run that asked for the chat
  # to be cleared has it cleared within five seconds of its end.
  jobs_after_run
  ticks=$((ticks + 1))
  if (( ticks % 6 == 0 )); then chat_alive || start_chat; fi
  # Retention ran at start; here once on each new day.
  today="$(date +%F)"
  if [[ "$today" != "$pruned" ]]; then
    prune_handover
    pruned="$today"
  fi
done
