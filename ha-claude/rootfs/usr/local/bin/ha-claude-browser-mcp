#!/usr/bin/env bash
# ha-claude-browser-mcp - the browser for the chat and the Web jobs:
# Microsoft's Playwright MCP over standard input and output, with the
# image's own headless Chromium. The flags are fixed here, not by the
# caller: Chromium's sandbox on, a new profile in memory for each session
# (no cookies, no logins kept), no tools a page offers itself, no snapshot
# written to a file after a page opens, no images in answers, and no other
# capability. It starts in a clean environment, so neither arguments nor
# variables of the caller (PLAYWRIGHT_MCP_*, NODE_OPTIONS, PATH) reach the
# server. Which of its tools may be used is the working folder's own rules.
#
# It filters no address: a page's redirect or its own requests go wherever
# they point.
set -u
if [[ "$(id -u)" == 0 ]]; then
  echo "ha-claude-browser-mcp: not as root; Chromium's sandbox needs another user" >&2
  exit 1
fi
home="${HOME:-/data/home}"
out="$home/.cache/ha-claude/browser"
mkdir -p -- "$out" 2>/dev/null || out="$(mktemp -d)"
exec env -i HOME="$home" LANG=C.UTF-8 TZ="${TZ:-UTC}" PATH=/usr/local/bin:/usr/bin:/bin \
  PLAYWRIGHT_BROWSERS_PATH=/usr/share/ha-claude/browsers \
  /usr/local/bin/playwright-mcp \
  --browser chromium --headless --isolated --sandbox --no-webmcp \
  --snapshot-mode none --image-responses omit \
  --output-dir "$out" --output-max-size 1048576 \
  --timeout-navigation 30000
