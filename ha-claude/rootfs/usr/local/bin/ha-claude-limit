#!/usr/bin/env bash
# ha-claude-limit SECONDS COMMAND... - runs the command, and ends it when it
# has run for the given number of seconds: asks it to stop, and kills it
# thirty seconds later if it has not. Exits with the command's own status, or
# with 124 when the time ran out.
limit="$1"; shift
grace="${HC_LIMIT_GRACE:-30}"
# The command leads its own process group where that is possible, so that
# what it started is stopped with it.
if command -v setsid >/dev/null 2>&1; then
  setsid "$@" &
else
  "$@" &
fi
pid=$!
stop() { kill "-$1" -- "-$pid" 2>/dev/null || kill "-$1" "$pid" 2>/dev/null; }
(
  for (( i = 0; i < limit; i++ )); do
    kill -0 "$pid" 2>/dev/null || exit 0
    sleep 1
  done
  # The command ended by itself in the last second: that is not a timeout.
  # What it left behind is stopped all the same.
  kill -0 "$pid" 2>/dev/null || { stop TERM && sleep 1 && stop KILL; exit 0; }
  stop TERM || exit 0
  for (( i = 0; i < grace; i++ )); do
    # The command is gone; what it started may not be.
    kill -0 "$pid" 2>/dev/null || { stop KILL; exit 3; }
    sleep 1
  done
  stop KILL
  exit 3
) &
watchdog=$!
wait "$pid"; status=$?
if wait "$watchdog"; then
  exit "$status"
fi
exit 124
