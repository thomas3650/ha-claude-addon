#!/usr/bin/env bash
# The loop inside the tmux chat session. Runs as the Claude user.
LIB=/usr/local/lib/ha-claude
for f in paths log options env retention session; do
  # shellcheck disable=SC1090
  . "$LIB/$f.sh"
done

cd "$HC_WORKSPACE" || exit 1
quick_exits=0

while true; do
  if ! logged_in; then
    cat <<'EOT'

  Claude Code is not logged in.

  1. Run:  claude
  2. Follow the login link and accept the prompts it shows.
     The link is longer than one line: copy all of it and take out the
     line breaks before opening it.
  3. Exit Claude, then run:  exit
     The add-on starts the chat session within a minute.

EOT
    exec bash -l
  fi
  next_chat_argv
  clean_handover
  started=$SECONDS
  "${CHAT_ARGV[@]}"
  rc=$?
  # Continuing a conversation that ended at once: start a new one now,
  # without counting this exit (see chat_resume_failed).
  if chat_resume_failed "$((SECONDS - started))"; then
    echo "Claude Code could not continue the last conversation (code $rc). Starting a new one."
    continue
  fi
  quick_exits="$(chat_quick_exits "$quick_exits" "$((SECONDS - started))")"
  # A count that is no number means the rule itself is broken: leave the shell.
  [[ "$quick_exits" =~ ^[0-9]+$ ]] || quick_exits=3
  if (( quick_exits >= 3 )); then
    echo "Claude Code exited three times within 30 seconds (last code $rc)."
    echo "Leaving a shell here. Type 'exit' to let the add-on try again."
    exec bash -l
  fi
  echo "Claude Code exited with code $rc. Starting again in 10 seconds."
  sleep 10
done
